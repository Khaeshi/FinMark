{
    "$schema": "https://turbo.build/schema.json",
    "concurrency": "15",
    "tasks": {
      "dev": {
        "cache": false,
        "persistent": true
      },
      "build": {
        "dependsOn": ["^build"],
        "outputs": [".next/**", "dist/**"]
      },
      "test": {
        "cache": false
      }
    }
  }