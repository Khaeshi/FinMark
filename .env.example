# ─── Database ─────────────────────────────────────────────────────────────────
# Neon free tier (prototype) — get from neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/finmark?sslmode=require"

# Read replica — use same URL for prototype, separate for production
DATABASE_READ_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/finmark?sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local dev: redis://localhost:6379
# Production: AWS ElastiCache URL
REDIS_URL="redis://localhost:6379"

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION="ap-southeast-1"

# Cognito — get from AWS Console after setup
COGNITO_USER_POOL_ID="ap-southeast-1_XXXXXXXXX"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
COGNITO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SQS queues
SQS_ORDER_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/123456789/finmark-orders"
SQS_NOTIFICATION_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/123456789/finmark-notifications"

# KMS
KMS_KEY_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─── Services ─────────────────────────────────────────────────────────────────
NODE_ENV="development"

# Service ports
PORT=4000
USER_AUTH_SVC_PORT=4001
ORDER_SVC_PORT=4002
REPORT_SVC_PORT=4003
PRODUCT_SVC_PORT=4004
ADMIN_SVC_PORT=4005
FEEDBACK_SVC_PORT=4006

# Service URLs (used by api-gateway to proxy)
USER_AUTH_SVC_URL="http://localhost:4001"
ORDER_SVC_URL="http://localhost:4002"
REPORT_SVC_URL="http://localhost:4003"
PRODUCT_SVC_URL="http://localhost:4004"
ADMIN_SVC_URL="http://localhost:4005"
FEEDBACK_SVC_URL="http://localhost:4006"

# Internal service auth
INTERNAL_SERVICE_SECRET="replace-with-strong-secret-minimum-32-chars"

# ─── Next.js Frontend ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to use mock data instead of real API (no backend needed)
NEXT_PUBLIC_USE_MOCK="false"
