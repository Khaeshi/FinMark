#DATABASE
# AWS RDS PostgreSQL connection string (temporary sicne we're not using database)
DATABASE_URL="postgresql://finmark_user:password@localhost:5432/finmark_dev"

# Read replica (used by report-svc and admin-svc)
DATABASE_READ_URL="postgresql://finmark_user:password@localhost:5432/finmark_dev"

# Redis 
# AWS ElastiCache Redis
REDIS_URL="redis://localhost:6379"

# AWS 
AWS_REGION="ap-southeast-1"

# Cognito
COGNITO_USER_POOL_ID="ap-southeast-1_XXXXXXXXX"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxx"
COGNITO_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# SQS queues
SQS_ORDER_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/123456789/finmark-orders"
SQS_NOTIFICATION_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/123456789/finmark-notifications"

# KMS (encryption)
KMS_KEY_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─── Services ─────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# JWT secret for internal service-to-service auth
INTERNAL_SERVICE_SECRET="replace-with-strong-secret-minimum-32-chars"

# ─── Next.js (apps/web) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"
